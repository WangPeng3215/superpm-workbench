[Unit]
Description=superPM 需求工作台
Documentation=https://github.com/WangPeng3215/superpm-workbench
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SVC_USER__
Group=__SVC_USER__
WorkingDirectory=__APP_DIR__
# 端口、数据根、监听地址、种子口令都在这里配置（权限 640，仅 root 与服务用户可读）
EnvironmentFile=__ENV_FILE__
ExecStart=__NODE_BIN__ apps/server/dist/index.js
# 崩溃自动拉起；systemctl stop 时按正常退出不再重启
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=superpm
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
